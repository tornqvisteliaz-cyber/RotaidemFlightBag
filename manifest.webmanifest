{
  "name": "Rotaidem Flight Bag",
  "short_name": "Flight Bag",
  "description": "Electronic flight bag for flight simulation: charts, enroute map, performance, SimBrief briefing.",
  "start_url": "./?standalone",
  "scope": "./",
  "display": "fullscreen",
